# Copy to .env before running `docker compose up -d --build`

DB_USER=flowforge
DB_PASSWORD=change-me
DB_NAME=flowforge

# at least 32 characters. generate one with: openssl rand -hex 32
JWT_SECRET=

# Where the browser reaches each service. Change both when deploying to a domain,
# then rebuild: docker compose up -d --build
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api

# Number of reverse proxies in front of the API (0 = none, 1 = Caddy/nginx)
TRUST_PROXY=0

# Used by: docker compose exec api node dist/database/seed.js
SEED_ADMIN_EMAIL=admin@flowforge.local
SEED_ADMIN_PASSWORD=
