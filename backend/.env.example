NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# how many reverse proxies sit in front of the API (0 = none). Set to 1 behind Caddy/nginx.
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=flowforge
DB_PASSWORD=
DB_NAME=flowforge

# at least 32 characters. generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRES_IN_SECONDS=3600

# used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@flowforge.local
SEED_ADMIN_PASSWORD=
